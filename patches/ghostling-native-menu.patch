+// Pending menu-generated OSC payloads. Menu handlers (menu.m) queue here
+// rather than writing directly: while a modal panel is up the render loop is
+// paused, so toast's output can fill the PTY buffer and a direct write would
+// EAGAIN and drop. The render loop flushes the queue right after draining the
+// PTY, when the buffer has room.
+static char g_osc_queue[32768];
+static size_t g_osc_queue_len = 0;
+
+void toast_pty_write(const char *data)
+{
+    size_t len = strlen(data);
+    if (len == 0 || g_osc_queue_len + len >= sizeof(g_osc_queue))
+        return;
+    memcpy(g_osc_queue + g_osc_queue_len, data, len);
+    g_osc_queue_len += len;
+}
+
+// Flush queued OSC payloads to the PTY. Called from the render loop after the
+// PTY has been drained so the kernel buffer has room.
+void toast_flush_osc(void)
+{
+    if (g_osc_queue_len == 0 || g_pty_fd < 0)
+        return;
+    pty_write(g_pty_fd, g_osc_queue, g_osc_queue_len);
+    g_osc_queue_len = 0;
+}
