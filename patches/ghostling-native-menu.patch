diff --git a/menu.m b/menu.m
new file mode 100644
index 0000000..23e80cc
--- /dev/null
+++ b/menu.m
@@ -0,0 +1,214 @@
+// menu.m — Native macOS menu bar for the toast bundle terminal.
+//
+// Installs the standard File / Edit / View menus (plus the app menu) on the
+// ghostling window. Menu items with Cmd key equivalents are intercepted by
+// macOS and never reach the terminal; each item's action forwards the
+// equivalent TUI command to toast through a custom OSC payload written to the
+// PTY:
+//
+//   \x1b]1337;toast-action;<name>\x1b\\      — trigger a toast action
+//   \x1b]1337;toast-open-file;<path>\x1b\\   — open a file
+//   \x1b]1337;toast-open-folder;<path>\x1b\\ — open a folder as the workspace
+//
+// toast parses these in internal/app (handleToastOSC).
+#import <Cocoa/Cocoa.h>
+
+// Provided by main.c: writes raw bytes to the PTY master.
+extern void toast_pty_write(const char *data);
+
+static void toast_write_osc(const char *payload)
+{
+    char buf[32768];
+    int n = snprintf(buf, sizeof(buf), "\x1b]1337;%s\x1b\\", payload);
+    if (n > 0 && n < (int)sizeof(buf))
+        toast_pty_write(buf);
+}
+
+// Open the native folder picker and send the chosen folder to toast. Called
+// from the File > Open Folder… menu item and from the pty marker scan in
+// main.c (toast's Select Workspace button requests this).
+// Show the About dialog: version (from TOAST_VERSION, set by the launcher)
+// and a link to the project's GitHub page.
+void toast_show_about(void)
+{
+    const char *ver = getenv("TOAST_VERSION");
+    NSString *version = ver && ver[0] ? [NSString stringWithUTF8String:ver] : @"dev";
+    NSString *url = @"https://github.com/paradise-runner/toast";
+
+    NSAlert *alert = [[NSAlert alloc] init];
+    [alert setMessageText:[NSString stringWithFormat:@"Toast %@", version]];
+    [alert setInformativeText:@"A fast, familiar terminal text editor for macOS."];
+
+    NSTextField *link = [[NSTextField alloc] initWithFrame:NSMakeRect(0, 0, 320, 20)];
+    [link setBordered:NO];
+    [link setEditable:NO];
+    [link setSelectable:YES];
+    [link setDrawsBackground:NO];
+    NSMutableAttributedString *linkText = [[NSMutableAttributedString alloc]
+        initWithString:url
+            attributes:@{
+                NSLinkAttributeName: url,
+                NSForegroundColorAttributeName: [NSColor linkColor],
+                NSUnderlineStyleAttributeName: @(NSUnderlineStyleSingle),
+            }];
+    [link setAttributedStringValue:linkText];
+    [alert setAccessoryView:link];
+
+    [alert runModal];
+}
+
+void toast_request_open_folder(void)
+{
+    NSOpenPanel *panel = [NSOpenPanel openPanel];
+    [panel setCanChooseFiles:NO];
+    [panel setCanChooseDirectories:YES];
+    [panel setAllowsMultipleSelection:NO];
+    [panel setDirectoryURL:[NSURL fileURLWithPath:NSHomeDirectory()]];
+    [panel setMessage:@"Choose a folder for toast to open"];
+    if ([panel runModal] == NSModalResponseOK) {
+        NSURL *url = [panel URL];
+        const char *path = [url fileSystemRepresentation];
+        char payload[16384];
+        int n = snprintf(payload, sizeof(payload), "toast-open-folder;%s",
+                         path ? path : "");
+        if (n > 0 && n < (int)sizeof(payload))
+            toast_write_osc(payload);
+    }
+}
+
+// MenuHandler is the target of every menu item. The action name lives in the
+// item's representedObject; selectors are resolved at runtime by AppKit.
+@interface ToastMenuHandler : NSObject
+@end
+
+@implementation ToastMenuHandler
+
+- (void)menuAction:(id)sender
+{
+    NSMenuItem *item = (NSMenuItem *)sender;
+    NSString *action = (NSString *)[item representedObject];
+    if (action.length == 0)
+        return;
+
+    if ([action isEqualToString:@"about"]) {
+        toast_show_about();
+        return;
+    }
+    if ([action isEqualToString:@"open-file"]) {
+        NSOpenPanel *panel = [NSOpenPanel openPanel];
+        [panel setCanChooseFiles:YES];
+        [panel setCanChooseDirectories:NO];
+        [panel setAllowsMultipleSelection:NO];
+        [panel setDirectoryURL:[NSURL fileURLWithPath:NSHomeDirectory()]];
+        [panel setMessage:@"Choose a file to open in toast"];
+        if ([panel runModal] == NSModalResponseOK) {
+            NSURL *url = [panel URL];
+            const char *path = [url fileSystemRepresentation];
+            char payload[16384];
+            int n = snprintf(payload, sizeof(payload), "toast-open-file;%s",
+                             path ? path : "");
+            if (n > 0 && n < (int)sizeof(payload))
+                toast_write_osc(payload);
+        }
+        return;
+    }
+    if ([action isEqualToString:@"open-folder"]) {
+        toast_request_open_folder();
+        return;
+    }
+
+    char payload[256];
+    int n = snprintf(payload, sizeof(payload), "toast-action;%s",
+                     [action UTF8String]);
+    if (n > 0 && n < (int)sizeof(payload))
+        toast_write_osc(payload);
+}
+
+@end
+
+// The handler singleton the items target.
+static ToastMenuHandler *handler(void);
+
+// Add an item to a menu with a target action and a toast action name.
+static void toast_menu_item(NSMenu *menu, NSString *title, NSString *key,
+                            NSString *actionName)
+{
+    NSMenuItem *item = [menu addItemWithTitle:title
+                                       action:@selector(menuAction:)
+                                keyEquivalent:key];
+    [item setTarget:handler()];
+    [item setRepresentedObject:actionName];
+}
+
+static ToastMenuHandler *handler(void)
+{
+    static ToastMenuHandler *h;
+    if (!h)
+        h = [[ToastMenuHandler alloc] init];
+    return h;
+}
+
+// Build the full main menu. Called once after the raylib window exists so the
+// menu bar is owned by the app's NSApplication.
+void toast_install_menu(void)
+{
+    @autoreleasepool {
+        NSApplication *app = [NSApplication sharedApplication];
+        NSMenu *mainMenu = [[NSMenu alloc] initWithTitle:@"MainMenu"];
+
+        // ── App menu ─────────────────────────────────────────────────────
+        NSMenuItem *appItem = [[NSMenuItem alloc] initWithTitle:@"Toast"
+                                                         action:NULL
+                                                  keyEquivalent:@""];
+        NSMenu *appMenu = [[NSMenu alloc] initWithTitle:@"Toast"];
+        toast_menu_item(appMenu, @"About Toast", @"", @"about");
+        [appMenu addItem:[NSMenuItem separatorItem]];
+        toast_menu_item(appMenu, @"Quit Toast", @"q", @"quit");
+        [appItem setSubmenu:appMenu];
+
+        // ── File ─────────────────────────────────────────────────────────
+        NSMenuItem *fileItem = [[NSMenuItem alloc] initWithTitle:@"File"
+                                                          action:NULL
+                                                   keyEquivalent:@""];
+        NSMenu *fileMenu = [[NSMenu alloc] initWithTitle:@"File"];
+        toast_menu_item(fileMenu, @"Open File…", @"o", @"open-file");
+        toast_menu_item(fileMenu, @"Open Folder…", @"O", @"open-folder");
+        [fileMenu addItem:[NSMenuItem separatorItem]];
+        toast_menu_item(fileMenu, @"Save", @"s", @"save");
+        [fileMenu addItem:[NSMenuItem separatorItem]];
+        toast_menu_item(fileMenu, @"Close Tab", @"w", @"close-tab");
+        [fileItem setSubmenu:fileMenu];
+
+        // ── Edit ─────────────────────────────────────────────────────────
+        NSMenuItem *editItem = [[NSMenuItem alloc] initWithTitle:@"Edit"
+                                                          action:NULL
+                                                   keyEquivalent:@""];
+        NSMenu *editMenu = [[NSMenu alloc] initWithTitle:@"Edit"];
+        toast_menu_item(editMenu, @"Undo", @"z", @"undo");
+        toast_menu_item(editMenu, @"Redo", @"Z", @"redo");
+        [editMenu addItem:[NSMenuItem separatorItem]];
+        toast_menu_item(editMenu, @"Cut", @"x", @"cut");
+        toast_menu_item(editMenu, @"Copy", @"c", @"copy");
+        toast_menu_item(editMenu, @"Paste", @"v", @"paste");
+        toast_menu_item(editMenu, @"Select All", @"a", @"select-all");
+        [editMenu addItem:[NSMenuItem separatorItem]];
+        toast_menu_item(editMenu, @"Find…", @"f", @"find");
+        [editItem setSubmenu:editMenu];
+
+        // ── View ─────────────────────────────────────────────────────────
+        NSMenuItem *viewItem = [[NSMenuItem alloc] initWithTitle:@"View"
+                                                          action:NULL
+                                                   keyEquivalent:@""];
+        NSMenu *viewMenu = [[NSMenu alloc] initWithTitle:@"View"];
+        toast_menu_item(viewMenu, @"Toggle Sidebar", @"b", @"toggle-sidebar");
+        toast_menu_item(viewMenu, @"Quick Open", @"p", @"quick-open");
+        toast_menu_item(viewMenu, @"Search", @"F", @"search");
+        [viewItem setSubmenu:viewMenu];
+
+        [mainMenu addItem:appItem];
+        [mainMenu addItem:fileItem];
+        [mainMenu addItem:editItem];
+        [mainMenu addItem:viewItem];
+        [app setMainMenu:mainMenu];
+    }
+}
