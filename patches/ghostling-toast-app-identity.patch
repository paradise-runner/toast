+    Image logo = LoadImageFromMemory(".png", toast_logo_png, (int)sizeof(toast_logo_png));
+    if (logo.data != NULL) {
+        SetWindowIcon(logo);
+        UnloadImage(logo);
+    }
     SetTargetFPS(60);
 
     // Query the DPI scale so we can rasterize the font at the true pixel
