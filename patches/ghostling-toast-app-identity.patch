diff --git a/CMakeLists.txt b/CMakeLists.txt
index 7882fb1..f65c4fa 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -50,8 +50,25 @@ add_custom_command(
   COMMENT "Generating font_jetbrains_mono.h"
 )
 
+# --- Embed app icon as a C header -------------------------------------------
+# The toast logo (assets/toast-logo.png, copied in by the toast bundle build
+# script) is baked into the binary so SetWindowIcon can brand the window even
+# when not launched from an .app bundle.
+set(ICON_INPUT "${CMAKE_SOURCE_DIR}/assets/toast-logo.png")
+set(ICON_HEADER "${CMAKE_BINARY_DIR}/toast_logo.h")
+add_custom_command(
+  OUTPUT "${ICON_HEADER}"
+  COMMAND ${CMAKE_COMMAND}
+    -DINPUT=${ICON_INPUT}
+    -DOUTPUT=${ICON_HEADER}
+    -DARRAY_NAME=toast_logo_png
+    -P ${CMAKE_SOURCE_DIR}/bin2header.cmake
+  DEPENDS "${ICON_INPUT}" "${CMAKE_SOURCE_DIR}/bin2header.cmake"
+  COMMENT "Generating toast_logo.h"
+)
+
 # --- Our Project -------------------------------------------------------------
-add_executable(${PROJECT_NAME} main.c "${FONT_HEADER}")
+add_executable(${PROJECT_NAME} main.c "${FONT_HEADER}" "${ICON_HEADER}")
 target_compile_features(${PROJECT_NAME} PRIVATE c_std_11)
 target_include_directories(${PROJECT_NAME} PRIVATE "${CMAKE_BINARY_DIR}")
 target_link_libraries(${PROJECT_NAME} raylib ghostty-vt)
