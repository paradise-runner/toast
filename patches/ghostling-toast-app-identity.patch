-    InitWindow(800, 600, "ghostling");
+    InitWindow(800, 600, "toast");
     SetWindowState(FLAG_WINDOW_RESIZABLE);
     SetExitKey(KEY_NULL);
+
+    // Brand the window with the toast logo (dock / alt-tab icon). The
